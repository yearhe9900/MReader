# Flutter / Dart
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies
build/

# IDE
.idea/
*.iml
*.ipr
*.iws
.vscode/

# 平台目录下的生成物（平台目录本身要纳管：含 AndroidManifest / Info.plist 等配置）
**/Pods/
**/.symlinks/
**/ephemeral/
**/Flutter/ephemeral/
**/Flutter/Generated.xcconfig
**/Flutter/flutter_export_environment.sh
ios/Runner/GeneratedPluginRegistrant.*
macos/Flutter/GeneratedPluginRegistrant.swift
linux/flutter/generated_*
windows/flutter/generated_*
android/local.properties
android/app/.cxx/
android/.gradle/
# Kotlin 2.x 增量编译缓存（KGP 2.3.20 起在 android/ 下生成）
android/.kotlin/
android/key.properties

# 杂项
.DS_Store
*.log

# 临时测试输出（负责人本机重定向产物，随跑随生成）
/docs/test-output.txt
.scratch_smoke.txt
# golden 比对失败产物（随跑随生成；同上游 06ac58a 约定）
test/**/failures/

# 性能基线样本（由 tool/gen_perf_fixtures.dart 生成，不入库）
/perf_fixtures/

# 本工程的 agent 工作数据（记忆、报告），不进源码历史
.workbuddy/
deliverables/

# 开发期真实书籍样本（多格式测试用，不入库）
/tmp_book/

# Rust（M3.5-T03，架构 §G.4）
rust/target/
rust_builder/**/build/
**/*.so
**/*.dylib
**/*.dll
# 显式反排除：FRB 生成物必须入库（RUST-08 ③）——未来若有人加 *.so 类通配，
# 不会误伤 lib/src/rust/**（防御性写法，与 test/generated_files_committed_test 配套）。
!lib/src/rust/**
